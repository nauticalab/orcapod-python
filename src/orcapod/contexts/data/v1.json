{
    "context_key": "std:v1:default",
    "version": "v1",
    "description": "Data context of Orcapod v0.3: the hashing generation H1. Frozen when v0.3.0 is released, except its golden history, which only grows; editable in place while that release is prepared.",
    "released_in": null,
    "previous": "std:v0.1:default",
    "file_hasher": {
        "_class": "orcapod.hashing.file_hashers.FileHasher",
        "_config": {
            "algorithm": "sha256"
        }
    },
    "directory_hasher": {
        "_class": "orcapod.hashing.directory_hashers.BasicDirectoryHasher",
        "_config": {
            "file_hasher": {
                "_ref": "file_hasher"
            },
            "algorithm": "sha256"
        }
    },
    "type_converter": {
        "_class": "orcapod.semantic_types.universal_converter.UniversalTypeConverter",
        "_config": {
            "logical_type_registry": {
                "_ref": "logical_type_registry"
            }
        }
    },
    "function_semantic_hasher": {
        "_class": "orcapod.hashing.semantic_hashing.function_info_extractors.FunctionSignatureExtractor",
        "_config": {
            "include_module": true,
            "include_defaults": true,
            "type_converter": {
                "_ref": "type_converter"
            }
        }
    },
    "python_type_handler_registry": {
        "_class": "orcapod.hashing.semantic_hashing.type_handler_registry.PythonTypeHandlerRegistry",
        "_config": {
            "handlers": [
                [
                    {
                        "_type": "builtins.bytes"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.BytesHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "builtins.bytearray"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.BytesHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "types.FunctionType"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.FunctionHandler",
                        "_config": {
                            "function_info_extractor": {
                                "_ref": "function_semantic_hasher"
                            }
                        }
                    }
                ],
                [
                    {
                        "_type": "types.BuiltinFunctionType"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.FunctionHandler",
                        "_config": {
                            "function_info_extractor": {
                                "_ref": "function_semantic_hasher"
                            }
                        }
                    }
                ],
                [
                    {
                        "_type": "types.MethodType"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.FunctionHandler",
                        "_config": {
                            "function_info_extractor": {
                                "_ref": "function_semantic_hasher"
                            }
                        }
                    }
                ],
                [
                    {
                        "_type": "builtins.type"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.TypeObjectHandler",
                        "_config": {
                            "type_converter": {
                                "_ref": "type_converter"
                            }
                        }
                    }
                ],
                [
                    {
                        "_type": "types.GenericAlias"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.GenericAliasHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "types.UnionType"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.UnionTypeHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "typing._GenericAlias"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.GenericAliasHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "typing._SpecialForm"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.SpecialFormHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "pyarrow.Table"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.ArrowTableHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "pyarrow.RecordBatch"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.ArrowTableHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "polars.Expr"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.PolarsExprHandler",
                        "_config": {}
                    }
                ],
                [
                    {
                        "_type": "orcapod.types.Schema"
                    },
                    {
                        "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.SchemaHandler",
                        "_config": {
                            "type_converter": {
                                "_ref": "type_converter"
                            }
                        }
                    }
                ]
            ]
        }
    },
    "semantic_hasher": {
        "_class": "orcapod.hashing.semantic_hashing.semantic_hasher.SemanticAwarePythonHasher",
        "_config": {
            "type_handler_registry": {
                "_ref": "python_type_handler_registry"
            }
        }
    },
    "arrow_hasher": {
        "_class": "orcapod.hashing.arrow_hashers.StarfixArrowHasher",
        "_config": {
            "type_converter": {
                "_ref": "type_converter"
            },
            "semantic_hasher": {
                "_ref": "semantic_hasher"
            }
        }
    },
    "definitions": {
        "source_identity": "source_identity_v1",
        "function_identity": "function_identity_v1",
        "operator_identity": "operator_identity_v1",
        "node_identity": "node_identity_v1",
        "record_id": "record_id_v1",
        "entry_id": "entry_id_v1",
        "system_tag_fold": "system_tag_fold_v1",
        "system_tag_naming": "system_tag_naming_v1",
        "source_info_naming": "source_info_naming_v1",
        "type_conversion": "type_conversion_v1"
    },
    "libraries": {
        "starfix": "0.5.0 (hash format 2, digest prefix 000002): Arrow table and schema hashes",
        "pyarrow": "23.0.1: conversion of Python values to Arrow types, which are hashed",
        "polars": "1.41.2: serialisation of filter expressions, which is hashed"
    },
    "golden": {
        "folder": "v1",
        "history": [
            {
                "date": "2026-11-16",
                "release": null,
                "added": {
                    "arrow-01.json": "c66fa55619178f2631d04232555cd58059813e97e9ecd2b9de9e63699e60c964",
                    "datagram-01.json": "598d4a2851819d76ba674e189222e61733ca1861ca82a59e990a8ee5e1b0a7b3",
                    "pipeline-01.json": "ec0049a39e85645d59d9a276a17528bfa64a91f349aa0094052a6d55bc930be5",
                    "schema-01.json": "79aa2a068e0724891cf43ee528ce8f569e65f08864faa5e34773bfc69ac9576e",
                    "semantic-01.json": "8e5d9dfff461f9f1d6bdd49a3019e7bf6122e75d799d725b17531d31b080003c",
                    "torch-01.json": "af2e8b68d66dffaa37e1d0ad75acd42f595d65b9fae00ddcde81bf9e13a265c8"
                },
                "previous": null,
                "digest": "0a789cf9e8d1df9fb762d6dc2fabffcd3383cd6a21ef147e8c6583f963280c2e"
            }
        ]
    },
    "changes": [
        {
            "definition": "arrow_hasher",
            "change": "starfix hash format 1 (starfix 0.4) to hash format 2 (starfix 0.5): every Arrow-derived hash value (ITL-910)"
        },
        {
            "definition": "semantic_hasher",
            "change": "hash label rule: a hash fed into another hash carries its label, so a nested hash enters its parent as {\"__type__\": \"hash\", \"label\": ..., \"digest\": ...} and every structure hash that contains a nested hash moves; bytes and UUID values hash as tagged data, and frozenset is tagged apart from set; labels are <algorithm>_v1, each defined once in code beside its algorithm and not in this file; the file hash keeps sha256 (ITL-945, revised by ITL-1154)"
        },
        {
            "definition": "arrow_hasher",
            "change": "hash label rule: the token of a value-hashed extension cell is the logical type identifier, then the value hash with its label (<identifier>::<label>:<digest>); a UUID column is hashed as stored; the order-including table hash is labelled arrow_ordered_v1 and enters the value hashes built on it with its label (ITL-945, revised by ITL-1154)"
        },
        {
            "definition": "entry_id",
            "change": "hash label rule: the input data hash enters the entry-id table, and the node content hash enters the operator-cache row key, with their labels; the folded source id of Batch and GroupBy carries batch_v1 / group_v1; names (function uri, path components) hold bare hex digests (ITL-945, revised by ITL-1154)"
        }
    ]
}
