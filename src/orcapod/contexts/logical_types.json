{
    "description": "Logical types registered in every data context, with the value handlers that hash their Python values. This file is not frozen: a logical type is versioned by its own identifier (Arrow extension name and metadata), not by the data context version, so adding one edits this file and no released data context manifest. hash_ignore lists, per extension name, the property names the value hash of a library value type ignores (empty: every property the storage keeps is part of the hash); the list is written into the type's extension metadata, so changing it changes the type's identifier. The logical type entry and the value handler entry of such a type both refer to their list as hash_ignore:<extension name>.",
    "hash_ignore": {
        "orcapod.numpy.ndarray": [],
        "orcapod.polars.dataframe": [],
        "orcapod.polars.series": []
    },
    "logical_type_registry": {
        "_class": "orcapod.logical_types.registry.LogicalTypeRegistry",
        "_config": {
            "logical_types": [
                {
                    "_class": "orcapod.logical_types.builtin_logical_types.LogicalPath",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.builtin_logical_types.LogicalUPath",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.builtin_logical_types.LogicalUUID",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.file_type.LogicalFile",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.directory_type.LogicalDirectory",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.numpy_type.LogicalNumpyArray",
                    "_config": {
                        "ignore": {
                            "_ref": "hash_ignore:orcapod.numpy.ndarray"
                        }
                    }
                },
                {
                    "_class": "orcapod.logical_types.pandas_type.LogicalPandasDataFrame",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.pandas_type.LogicalPandasSeries",
                    "_config": {}
                },
                {
                    "_class": "orcapod.logical_types.polars_type.LogicalPolarsDataFrame",
                    "_config": {
                        "ignore": {
                            "_ref": "hash_ignore:orcapod.polars.dataframe"
                        }
                    }
                },
                {
                    "_class": "orcapod.logical_types.polars_type.LogicalPolarsSeries",
                    "_config": {
                        "ignore": {
                            "_ref": "hash_ignore:orcapod.polars.series"
                        }
                    }
                }
            ],
            "factories": [
                {
                    "factory": {
                        "_class": "orcapod.logical_types.dataclass_logical_type_factory.DataclassLogicalTypeFactory",
                        "_config": {}
                    },
                    "category": "orcapod.dataclass",
                    "python_bases": [
                        {
                            "_type": "builtins.object"
                        }
                    ]
                },
                {
                    "factory": {
                        "_class": "orcapod.logical_types.structural_logical_type_factory.StructuralLogicalTypeFactory",
                        "_config": {}
                    },
                    "category": "orcapod.structural"
                },
                {
                    "factory": {
                        "_class": "orcapod.logical_types.pydantic_logical_type_factory.PydanticLogicalTypeFactory",
                        "_config": {}
                    },
                    "category": "orcapod.pydantic",
                    "python_bases": [
                        {
                            "_type": "pydantic.BaseModel"
                        }
                    ]
                },
                {
                    "factory": {
                        "_class": "orcapod.logical_types.list_logical_type_factory.ListLogicalTypeFactory",
                        "_config": {}
                    },
                    "category": "list"
                },
                {
                    "factory": {
                        "_class": "orcapod.logical_types.list_logical_type_factory.ListLogicalTypeFactory",
                        "_config": {}
                    },
                    "category": "set"
                }
            ]
        }
    },
    "value_handlers": [
        [
            {
                "_type": "uuid.UUID"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.UUIDHandler",
                "_config": {}
            }
        ],
        [
            {
                "_type": "orcapod.logical_types.file_type.File"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.FileHandler",
                "_config": {
                    "file_hasher": {
                        "_ref": "file_hasher"
                    }
                }
            }
        ],
        [
            {
                "_type": "orcapod.logical_types.directory_type.Directory"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.DirectoryHandler",
                "_config": {
                    "directory_hasher": {
                        "_ref": "directory_hasher"
                    }
                }
            }
        ],
        [
            {
                "_type": "numpy.ndarray"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.NumpyArrayHandler",
                "_config": {
                    "ignore": {
                        "_ref": "hash_ignore:orcapod.numpy.ndarray"
                    }
                }
            }
        ],
        [
            {
                "_type": "pandas.DataFrame"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.PandasDataFrameHandler",
                "_config": {}
            }
        ],
        [
            {
                "_type": "pandas.Series"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.PandasSeriesHandler",
                "_config": {}
            }
        ],
        [
            {
                "_type": "polars.DataFrame"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.PolarsDataFrameHandler",
                "_config": {
                    "ignore": {
                        "_ref": "hash_ignore:orcapod.polars.dataframe"
                    }
                }
            }
        ],
        [
            {
                "_type": "polars.Series"
            },
            {
                "_class": "orcapod.hashing.semantic_hashing.builtin_handlers.PolarsSeriesHandler",
                "_config": {
                    "ignore": {
                        "_ref": "hash_ignore:orcapod.polars.series"
                    }
                }
            }
        ]
    ]
}
